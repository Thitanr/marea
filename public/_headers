/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  X-XSS-Protection: 0
  Referrer-Policy: no-referrer
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Access-Control-Allow-Origin: https://marea.lanatech.tech
  Permissions-Policy: camera=(self), microphone=(), geolocation=(self), payment=(), usb=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; manifest-src 'self'; media-src 'self' blob:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests;

/
  Cache-Control: no-transform, no-cache

/service-worker.js
  Cache-Control: no-cache

# Face model + MediaPipe wasm runtime — immutable, cache forever at the HTTP layer too
/models/*
  Cache-Control: public, max-age=31536000, immutable
/mediapipe/*
  Cache-Control: public, max-age=31536000, immutable
